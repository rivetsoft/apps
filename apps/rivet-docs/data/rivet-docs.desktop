[Desktop Entry]
Type=Application
Name=Rivet Docs
GenericName=Document Viewer
Comment=Read PDFs and comics
Exec=rivet-docs %f
Icon=rivet-docs
Terminal=false
Categories=Office;Viewer;Graphics;
Keywords=rivet;pdf;document;reader;viewer;comic;cbz;cbr;
MimeType=application/pdf;application/x-pdf;application/vnd.comicbook+zip;application/x-cbz;application/vnd.comicbook-rar;application/x-cbr;application/x-cb7;
StartupWMClass=rivet-docs
