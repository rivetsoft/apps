[Desktop Entry]
Type=Application
Name=Rivet Edit
GenericName=Code Editor
Comment=A lightweight code editor for folders and files
Exec=rivet-edit %F
Icon=rivet-edit
Terminal=false
Categories=Development;TextEditor;
Keywords=code;editor;text;programming;source;
MimeType=text/plain;text/x-rust;text/x-python;text/javascript;application/json;text/x-csrc;text/x-go;text/html;text/css;application/toml;application/x-yaml;text/x-shellscript;text/markdown;inode/directory;
StartupWMClass=rivet-edit
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=rivet-edit --new-window
