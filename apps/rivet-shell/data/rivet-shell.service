# Rivet Shell as a service of your login session, started with the graphical session and
# started again if it stops by accident. `rivet-shell --install-service` puts this in place
# for you, with the program's full path.
#
# It starts where the compositor brings up graphical-session.target and hands the session's
# environment to systemd (niri-session and uwsm do). Elsewhere, start the shell from the
# compositor's own settings instead.

[Unit]
Description=Rivet Shell
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStart=rivet-shell
# systemd does the watching, so the shell runs without its own watcher.
Environment=RIVET_SHELL_NO_WATCH=1
Restart=on-failure
RestartSec=1
# 3: a shell is already running in the session. Not something to try again.
RestartPreventExitStatus=3
# Apps opened from the launcher and dock keep running when the shell stops or restarts.
KillMode=process

[Install]
WantedBy=graphical-session.target
